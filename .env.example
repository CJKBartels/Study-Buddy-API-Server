# Copy to .env and fill in. Loaded by `npm run dev` via env-cmd.

# Port the HTTP server listens on
PORT=3000

# MongoDB connection string (Atlas or local), e.g. mongodb://localhost:27017/study-buddy
MONGODB_URL=

# Secret used to sign and verify JWTs. Use a long random string.
JSON_WEB_TOKEN_SECRET=

# Optional. Number of proxies in front of the app, so rate limiting sees the
# visitor's IP. Leave unset locally. Set to 2 on App Platform (DigitalOcean's
# router, then Cloudflare).
# TRUST_PROXY=2

# Optional. Sign-in attempts allowed per IP and email in 15 minutes, and new
# accounts allowed per IP in an hour. The values below are the defaults.
# SIGN_IN_LIMIT=10
# SIGN_UP_LIMIT=5
